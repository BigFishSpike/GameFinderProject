@model List<GameListViewModel>

@{
    ViewData["Title"] = "My Games List";
}

<h1 class="text-center">My Games List</h1>
<hr />

@if (!Model.Any())
{
    <div class ="text-center">
    <p class="text-center">Your list is empty!</p> 
         <a asp-controller="Game"asp-action="List" class="btn btn-primary"> Click here to view all the games and find one to add!</a>
         </div>
}
else
{
    <div class="flex-container">
        @foreach (GameListViewModel game in Model)
        {
            <partial name="_GamesPartial" model="game" />
        }
    </div>
}

