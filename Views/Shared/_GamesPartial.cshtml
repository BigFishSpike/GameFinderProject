@model GameListViewModel

<div class="card mb-2">

<a asp-controller ="Game" asp-action = "Details" asp-route-id="@Model.Id" class = "text-decoration-none text-dark">

    <div class="card-body">
        <h5 class="card-title mb-1"> @Model.Name</h5>

        <img src="@Model.ImageUrl" class ="game-image" alt="@Model.Name" />

        @if(Model.ShowGenre)
        {
            <p> Genre: @Model.GenreName</p>
        }
                   
        </div>
    </a>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="card-body pt-0">
            <form asp-controller="UserFavourite" asp-action="Add" method="post">

                <input type="hidden" name="gameId" value="@Model.Id" />

                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                <button type="submit" class="btn btn-primary"> Add to Favourites </button>

            </form>
        </div>
    }

</div>

