@model GenreListViewModel

<a asp-controller="Genre" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">


<div class="card mb-2">
    <img src="@Model.ImageUrl" class="genre-image" alt="@Model.Name" />
    <div class="card-body">
        <h5 class="card-title mb-1"> @Model.Name</h5>  
    </div>
</div>

</a>