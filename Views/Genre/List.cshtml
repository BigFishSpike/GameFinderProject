@model IEnumerable<GenreListViewModel>
@{    
    ViewData["Title"] = "Genres";
}
<h1 class ="text-center">Genres</h1>
<hr />
<p class ="text-center">Want a specific genre? You're in the right place!</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex justify-content-end mb-3">

        <a asp-controller="Genre" asp-action="Add" class="btn btn-success"> <i class="bi bi-plus-circle"></i> Add a genre </a>

    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">
        @errorMessage
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<div class = "flex-container">


@foreach (GenreListViewModel genre in Model)
{
    <partial name="_GenresPartial" model="genre"/>
}

</div>