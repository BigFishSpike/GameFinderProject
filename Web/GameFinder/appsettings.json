{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowerCase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueCharacters": 3,
      "RequiredLength": 6
    },
    "SignIn": {
      "RequireConfirmedAccount": true
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "ConnectionStrings": {
    "SqlTesting": "Server=;Database=GameFinder;Trusted_Connection=True;Encrypt=False;",
    "IdentityNotesApplicationDbContext": "Server=(localdb)\\mssqllocaldb;Database=IdentityNotesApplicationDbContext;Trusted_Connection=True;MultipleActiveResultSets=true",
    "GameFinderDbContext": "Server=(localdb)\\mssqllocaldb;Database=GameFinderDbContext;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}