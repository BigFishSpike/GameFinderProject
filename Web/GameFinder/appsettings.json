{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowerCase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueCharacters": 3,
      "RequiredLength": 6
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=GameFinder;Trusted_Connection=True;Encrypt=False;"
  }
}