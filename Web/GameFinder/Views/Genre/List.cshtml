@model IEnumerable<GenreListViewModel>
@{    
    ViewData["Title"] = "Genres";
}
<h1 class ="text-center">Genres</h1>
<hr />
<p class="text-center">Want a specific genre? You're in the right place! And if you want to add a new genre, use the below button to do it!</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex justify-content-center mb-3">

        <a asp-controller="Genre" asp-action="Add" class="btn btn-success"> <i class="bi bi-plus-circle"></i> Create new genre </a>

    </div>
}

<div class = "flex-container">


@foreach (GenreListViewModel genre in Model)
{
    <partial name="_GenresPartial" model="genre"/>
}

</div>