@model GenreDeleteViewModel

@{
    ViewData["Title"] = "Delete Genre";
}

<h1 class="text-center">Delete Genre</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
       
        <div class="alert alert-warning" role="alert"> Are you sure you want to delete <strong>@Model.Name</strong>? Any games belonging to this genre will be reassigned to the genre you select below.
            
        </div>

        <form asp-controller="Genre" asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">

                <label asp-for="ReplacementGenreId" class="form-label"> Replacement Genre </label>

                <select asp-for="ReplacementGenreId" asp-items="Model.ReplacementGenre" class="form-select"> <option value="">-- Select a replacement genre --</option> </select>

                <span asp-validation-for="ReplacementGenreId" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">

                <a asp-controller="Genre" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"> Cancel </a>

                <button type="submit" class="btn btn-danger"> Delete Genre </button>

            </div>
        </form>
    </div>
</div>