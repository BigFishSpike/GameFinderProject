@model GameDeleteViewModel

<h3 class="text-center">Delete Game</h3>

<div class="alert alert-warning" role="alert"> Are you sure you want to delete this game? This cannot be undone. </div>

<div class="card game-delete-card">

        <h5 class="text-center" >@Model.Name</h5>
                    <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl)" alt="@Model.Name" />

</div>


<form asp-controller="Game" asp-action="Delete" method="post" class="game-delete-form">

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Confirm deletion</button>

    <a asp-controller="Game" asp-action="Details" asp-route-id="@Model.Id"class="btn btn-secondary"> Cancel </a>

</form>