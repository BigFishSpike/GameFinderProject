@model GameDetailsViewModel

@{    
    ViewData["Title"] = @Model.Name;
}
<h1 class ="text-center">@Model.Name</h1>
<hr />

 <div class = "row-justify-content-center"> <div class = "col-md-8"> <img src="@Model.ImageUrl" alt= "@Model.Name" class = "game-image mb-3"/>

    <p> Description: @Model.Description</p>
            <p>
                Difficulties:
                @if (Model.Difficulties.Count > 0)
                {
                    @string.Join(", ", Model.Difficulties)
                }
                else
                {
                    <span>Unspecified</span>
                }
            </p>
            <p> 
                Gamemodes:              
                @if (Model.Modes.Count > 0)
                {
                    @string.Join(", ", Model.Modes)
                }
                else
                {
                    <span>Unspecified</span>
                }
                
            </p>
            
            <p>
                Player options: 
                @if (Model.PlayerOptions.Count > 0)
                {
                    @string.Join(", ", Model.PlayerOptions)
                }
                else
                {
                    <span>Unspecified</span>
                }

            </p>

        <p> Release date: @Model.ReleaseDate.ToString(ApplicationDateFormat)</p>

        @if (Model.IsOwner)
        {
            <a asp-controller="Game" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> Delete Game </a>

            <a asp-controller="Game" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"> <i class="bi bi-pencil-square"></i> Edit Game </a>

        }

    </div>
</div>