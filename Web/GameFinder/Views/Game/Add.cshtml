@model GameAddViewModel

<h3 class="text-center">Add your game of choice</h3>

<form asp-controller="Game" asp-action="Add" method="post">

    <div class="mb-2">

        <label class="text-capitalize">Game name:</label>

        <p class="form-text">Give us the name of the game!</p>

        <input asp-for="Name" class="form-control" />

        <span asp-validation-for="Name" class="text-danger"></span>

    </div>

    <div class="mb-2">

        <label class="text-capitalize">Game description:</label>
        <p class="form-text">What's the game about? Make it enticing, and give people a reason to want to dive into it!</p>

        <textarea asp-for="Description" class="form-control"></textarea>

        <span asp-validation-for="Description" class="text-danger"></span>

    </div>

    <div class="mb-2">

        <label class="text-capitalize">Game image:</label>
        <p class="form-text">Add the game image URL here - you can use the game's cover image, so that it's recognised easily!</p>

        <input asp-for="ImageUrl" class="form-control" />

        <span asp-validation-for="ImageUrl" class="text-danger"></span>

    </div>

    <div class="mb-2">

        <label class="text-capitalize">Release date:</label>
        <p class="form-text">Try to remember it by heart - what are the odds you even remember the correct month or year?</p>

        <input asp-for="ReleaseDate" type="date" class="form-control" />

        <span asp-validation-for="ReleaseDate" class="text-danger"></span>

    </div>

    <div class="mb-2">

        <label class="text-capitalize">Genre name:</label>
        <p class="form-text">Can't find the right one? Add a new one to the Genres list first!</p>

        <select asp-for="GenreId" class="form-select"> <option value="0">Pick a genre</option>

            @foreach (GenreListViewModel genre in Model.Genres)
            {
                <option value="@genre.Id">@genre.Name</option>
            }

        </select>

        <span asp-validation-for="GenreId" class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label class="form-label">Difficulties:</label>
        <p class="form-text">How difficult is it? Does it have multiple difficulties? A difficulty slider counts for multiple!</p>

        @foreach (Difficulty difficulty in Enum.GetValues<Difficulty>())
        {
            <div class="form-check">

                <input class="form-check-input" type="checkbox" name="SelectedDifficulties" value="@((int)difficulty)" id="difficulty-@difficulty" />

                <label class="form-check-label" for="difficulty-@difficulty"> @difficulty </label>

            </div>
        }
    </div>

    <div class="mb-3">

        <label class="form-label">Modes:</label>
        <p class="form-text">Do you play against the machine, can you fight other people, or can you do both? Optional PvP still counts!</p>

        @foreach (Mode mode in Enum.GetValues<Mode>())
        {
            <div class="form-check">

                <input class="form-check-input" type="checkbox" name="SelectedMode" value="@((int)mode)" id="mode-@mode" />

                <label class="form-check-label" for="mode-@mode"> @mode </label>

            </div>
        }
    </div>

    <div class="mb-3">

        <label class="form-label">Player Options:</label>
        <p class="form-text">Is it singleplayer only, or does it have multiplayer as well? What about co-op where you work together, maybe even local co-op to play on one machine!</p>

        @foreach (PlayerOption playerOption in Enum.GetValues<PlayerOption>())
        {
            <div class="form-check">

                <input class="form-check-input" type="checkbox" name="SelectedPlayerOption" value="@((int)playerOption)" id="player-option-@playerOption" />

                <label class="form-check-label" for="player-option-@playerOption"> @playerOption </label>

            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Add it!</button>

</form>
