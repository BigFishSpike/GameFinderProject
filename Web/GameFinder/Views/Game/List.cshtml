@model IEnumerable<GameListViewModel>
@{    
    ViewData["Title"] = "Catalogue";
}
<h1 class="text-center">Catalogue</h1>
<hr />

@if (User.Identity == null || User.Identity?.IsAuthenticated == false)
{
    <p class="text-center">Below you'll find all the games that we have! Want to add one of your own? Register or log in, and do it!</p>
}

@if(User.Identity?.IsAuthenticated == true)
{
    <p class="text-center"> Below you'll find all the games that we have! Want to add a game of your own? Use the below button!</p>

    <div class="d-flex justify-content-center mb-3">

    <a asp-controller="Game" asp-action="Add" class="btn btn-success ms-5 mt-2"> <i class="bi bi-plus-circle"></i> Create new game </a>

    </div>
}


<div class = "flex-container">

@foreach (GameListViewModel game in Model)
{
    <partial name="_GamesPartial" model="game"/>
}
</div>