@model GameListViewModel

<div class="card mb-2 game-hover">

  <a asp-controller ="Game" asp-action = "Details" asp-route-id="@Model.Id" class = "text-decoration-none text-dark">

    <div class="card-body">

            @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="/images/placeholder.jpg" class="game-image placeholder-img" alt="@Model.Name" />
            }
            else
            {
                <img src="@Model.ImageUrl" class="game-image" alt="@Model.Name" />
            }
            
            <p class="game-genre text-center mb-2"> Genre: @Model.GenreName</p>

            <h5 class="game-genre text-center"> @Model.Name</h5>

        </div>
  </a>
  
  <form asp-controller="UserFavourite" asp-action="Remove" method="post" class="text-center mb-3">

       @Html.AntiForgeryToken()

       <input type="hidden" name="gameId" value="@Model.Id" />

       <button type="submit" class="btn btn-danger btn-sm"> Remove from Games List </button>
       
  </form>

</div>

