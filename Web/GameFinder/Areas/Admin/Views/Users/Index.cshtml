@model List<AdminUserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<h1>User Management</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"> @TempData["SuccessMessage"] </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger"> @TempData["ErrorMessage"] </div>
}

<table class="table">
    <thead>

        <tr>

            <th>Email</th>
            <th>Username</th>
            <th>Roles</th>
            <th>Actions</th>

        </tr>

    </thead>

    <tbody>
        @foreach (AdminUserViewModel user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>@string.Join(", ", user.Roles)</td>

                <td>

                    @if (!user.Roles.Contains(Administrator))
                    {
                        <a asp-area="Admin" asp-controller="Users" asp-action="Promote" asp-route-id="@user.Id" class="btn btn-success"> Promote </a>
                    }
                    else if (user.IsCurrentUser)
                    {
                        <span class="text-muted">No changes can be done to yourself</span>
                    }
                    else
                    {
                        <a asp-area="Admin" asp-controller="Users" asp-action="Demote" asp-route-id="@user.Id" class="btn btn-danger"> Demote </a>
                    }

                </td>

            </tr>
        }
    </tbody>


</table>