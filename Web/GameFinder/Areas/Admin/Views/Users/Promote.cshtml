@model AdminUserPromoteConfirmationViewModel

@{
    ViewData["Title"] = "Confirm Administrator";
}

<h1>Confirm Administrator</h1>

<p> Are you sure you want to make <strong>@Model.Email</strong> an Administrator? </p>

<form asp-area="Admin" asp-controller="Users" asp-action="Promote" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-success"> Confirm </button>

    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary"> Cancel </a>

</form>