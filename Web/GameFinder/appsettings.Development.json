{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowerCase": true,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueCharacters": 1,
      "RequiredLength": 3
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
}
